# hisi-patch 跟踪清单：一行一个路径或 glob（# 开头为注释）。
# 前缀 unowned: = 只纳入不属于任何 deb 包的文件（dpkg -S 判断）。
# 前缀 noauto:  = 只检测、--fix 不自动恢复（非本方文件，如 build-env agent 的 box64）。
# 修改本文件（或有意识地改过补丁）之后，运行 `hisi-patch-check snapshot` 重建黄金副本。
/usr/local/sbin/*
# /usr/sbin/init 已 dpkg-divert 成 init.systemd，这里是指向 d25-init 的相对符号链接（UOS initrd 会忽略 init= 参数）
/usr/sbin/init
/usr/local/bin/hciattach-hisi
noauto:/usr/local/bin/box64
# 天气壁纸 treeland 扩展（WeatherWallpaper 仓库 deepin-v25/ 的 install.sh 安装时才跟踪；没装时 snapshot 会跳过这几条）。
# 用 deb（wwp-weather-wallpaper）装的归 dpkg 管：unowned: 让它们不进基线，否则每次装卸 deb 都报警、--fix 还会把卸掉的文件恢复回来。
# 动态壁纸列表 metadata.json 不跟踪：它由安装脚本 / deb 的 postinst 生成（原列表 dpkg-divert 到 metadata.json.deepin），
# 卸载时要还原；dpkg -S 永远认为它属于 deepin-wallpapers。
unowned:/usr/local/bin/treeland-wallpaper-factory
unowned:/usr/local/bin/wwp-set
unowned:/usr/local/share/wallpapers/wwp/*/*
/usr/local/lib/hisi-mali/*
/usr/local/lib/hisi-nmfix/*
/usr/local/lib/hisi-treeland/*
/usr/local/lib/hisi-wpa/*
/usr/local/lib/hisi-bio/*
# 控制中心“账户 → 登录方式 → 手机解锁”插件（自建文件，不归任何 deb 包）
unowned:/usr/lib/*/dde-control-center/plugins_v1.0/phoneunlock/*
# 配对时弹认证框用的 polkit action（deb 也会装同一路径，交给 dpkg 管，别反复报警/复活）
unowned:/usr/share/polkit-1/actions/org.hisi.bio-unlock.policy
/etc/systemd/system/treeland.service.d/l540-no-rt.conf
/etc/systemd/system/treeland.service.d/l541-malibuf.conf
/etc/systemd/system/wpa_supplicant.service.d/hisi.conf
/etc/systemd/system/hciattach.service.d/hisi.conf
/etc/systemd/system/NetworkManager.service.d/hisi-station-fix.conf
/etc/systemd/system/hisi-ddm-watchdog.service
/etc/systemd/system/hisi-patch-check.service
/etc/systemd/system/hisi-patch-check-dpkg.service
/etc/dpkg/dpkg.cfg.d/zz-hisi-patch-check
/etc/systemd/system/hisi-next-boot.service
/etc/systemd/system/hisi-next-boot.timer
/etc/systemd/system/hisi-patch-firstboot.service
/etc/systemd/system/hisi-strip-selinux-xattr.service
/etc/systemd/system/hisi-bio-unlock.service
# hisi-bio-unlock 的 D-Bus 名字 org.hisi.BioUnlock1：给锁屏界面（libtl-lockbio）状态、给 hisi-phone-link 转手机请求
/etc/dbus-1/system.d/org.hisi.BioUnlock1.conf
# 手机指纹解锁：Wi-Fi / 蓝牙收发服务和它的运行用户 hisi-phone
/etc/systemd/system/hisi-phone-link.service
/etc/sysusers.d/hisi-phone.conf
/usr/local/lib/hisi-patch/apt-pre-hook
/usr/local/lib/hisi-patch/wait-dpkg-idle
/etc/systemd/system/ddm.service.d/hisi-seatd-wait.conf
/etc/NetworkManager/conf.d/90-l540-hisi.conf
/etc/NetworkManager/conf.d/wifi-powersave-off.conf
/etc/systemd/resolved.conf.d/l540-fallback-dns.conf
/etc/glvnd/egl_vendor.d/10_hisi_mali.json
/etc/X11/default-display-manager
# 声音：PipeWire 选华为配置集、固定 DMA 周期；配置集和 path 是装机时从 UOS 复制进 ACP 目录的
/etc/udev/rules.d/91-pipewire-huawei.rules
/etc/wireplumber/wireplumber.conf.d/90-hisi-da-combine.conf
unowned:/usr/share/alsa-card-profile/mixer/profile-sets/pulse-huawei.conf
unowned:/usr/share/alsa-card-profile/mixer/paths/*-huawei*.conf
/usr/bin/fingerprint_daemon
# 指纹/人脸：deepin-authenticate 按 /proc/self/exe 匹配白名单；ddm/treeland 是 d25 的认证调用进程
/usr/share/deepin-authentication/allowlist
/usr/share/deepin-authentication/app-type-list
unowned:/usr/lib/*.so*
noauto:/usr/lib/box64-x86_64-linux-gnu/*
noauto:/etc/box64.box64rc
noauto:/etc/binfmt.d/box64.conf
