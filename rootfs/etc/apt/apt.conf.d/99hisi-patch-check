// hisi-patch-check：dpkg 事务后自动校验 L540 本地补丁是否被覆盖。
// 两个钩子都必须 || true，绝不能让 apt 失败。
// 先取消 dpkg 层钩子排队的延时自检（/etc/dpkg/dpkg.cfg.d/zz-hisi-patch-check），由这里当场检查，避免同一次更新报两遍。
DPkg::Post-Invoke { "systemctl stop hisi-patch-check-dpkg.service >/dev/null 2>&1; /usr/local/sbin/hisi-patch-check --apt-hook || true" };
DPkg::Pre-Install-Pkgs { "/usr/local/lib/hisi-patch/apt-pre-hook || true" };
